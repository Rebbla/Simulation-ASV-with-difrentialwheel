    <model name="wall_e"><static>true</static><pose>1.525 0 0.05 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.05 3.0 0.1</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><box><size>0.05 3.0 0.1</size></box></geometry></collision></link></model>
