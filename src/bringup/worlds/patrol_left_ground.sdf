<?xml version="1.0" ?>
<!-- ASV KKI 2026 versi DARAT (robot 2 roda) - arena LEFT 30x30 m, origin di tengah, Z=0 lantai
     Saran spawn robot: x=10.60 y=-10.20 z=0.05 yaw=1.5708 (menghadap utara, keluar dari dermaga) -->
<sdf version="1.9">
  <world name="patrol_left_ground">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <gravity>0 0 -9.8</gravity>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.4750</latitude_deg>
      <longitude_deg>102.1000</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.53 0.74 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>32.0 32.0 0.1</size></box></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.6 0.6 0.63 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual><collision name="collision"><geometry><box><size>32.0 32.0 0.1</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision></link></model>
    <model name="wall_n"><static>true</static><pose>0.000 15.150 0.15 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>30.6 0.3 0.3</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><box><size>30.6 0.3 0.3</size></box></geometry></collision></link></model>
    <model name="wall_s"><static>true</static><pose>0.000 -15.150 0.15 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>30.6 0.3 0.3</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><box><size>30.6 0.3 0.3</size></box></geometry></collision></link></model>
    <model name="wall_e"><static>true</static><pose>15.150 0.000 0.15 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 30.0 0.3</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><box><size>0.3 30.0 0.3</size></box></geometry></collision></link></model>
    <model name="wall_w"><static>true</static><pose>-15.150 0.000 0.15 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 30.0 0.3</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><box><size>0.3 30.0 0.3</size></box></geometry></collision></link></model>
    <model name="buoy_green_01"><static>true</static><pose>11.500 0.700 0.15 0 0 0</pose><link name="link"><visual name="visual"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>0.1 0.75 0.15 1</ambient><diffuse>0.1 0.75 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="collision"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision></link></model>
